# Copier en .env (jamais versionne) et renseigner.

APP_NAME="Devups"
APP_URL=http://127.0.0.1
APP_PORT=:3031
APP_PROD=false
FRONT_URL=http://localhost:5173/
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_LANG=fr
PROJECT_ID=devups

DB_HOST=localhost
DB_NAME=devups
DB_USER=root
DB_PASSWORD=
# DB_DUMPER=false
# DB_TRANSACTION=true

# ROUTE_CACHE=false
# CACHE_VERSION=1.0.0

# Synchronisation toolrad (optionnelle)
# TOOLRAD_SERVER=https://toolrad.spacekola.com/api/
# TOOLRAD_API_KEY=

MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Devups"

JWT_SECRET=change-me
JWT_EXPIRE=false

CRON_TOKEN=change-me

FCM_PAIR_KEY=
FCM_USER_ID=
FCM_PROJECT_ID=
FCM_AUTH_FILE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Web Push (VAPID) - generer avec: php -r "require 'vendor/autoload.php'; print_r((new Minishlink\WebPush\VAPID())::createVapidKeys());"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Journalisation applicative (dclass/devups/Log.php, table dvups_log)
# LOG_MIN_LEVEL=warning
# LOG_RETENTION_DAYS=90

# Expiration des codes a 6 chiffres (activation de compte, changement de
# telephone) et du jeton dedie de reinitialisation de mot de passe
# ACTIVATION_CODE_TTL_MINUTES=15
# RESET_PASSWORD_TOKEN_TTL_MINUTES=30

# Limiteur de frequence (connexion, verification/renvoi de code)
# RATE_LIMIT_CODE_MAX_ATTEMPTS=5
# RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
# RATE_LIMIT_LOGIN_MAX_ATTEMPTS_IP=20
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_RESEND_MAX_ATTEMPTS=3
# RATE_LIMIT_RESEND_WINDOW_SECONDS=3600

# IP(s) de reverse proxy/load balancer de confiance (separees par des
# virgules) - sans cette liste, X-Forwarded-For (et assimiles) est TOUJOURS
# ignore pour determiner l'IP du client (voir Util::get_IP_address()).
# TRUSTED_PROXIES=

# LANG_COLLECT=true
