# Copier en .env (jamais versionne) et renseigner.

APP_NAME="Devups"
APP_URL=http://127.0.0.1
APP_PORT=:3031
APP_PROD=false
FRONT_URL=http://localhost:5173/
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_LANG=fr
PROJECT_ID=devups

DB_HOST=localhost
DB_NAME=devups
DB_USER=root
DB_PASSWORD=

MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Devups"

JWT_SECRET=change-me
JWT_EXPIRE=false

CRON_TOKEN=change-me

FCM_PAIR_KEY=
FCM_USER_ID=
FCM_PROJECT_ID=
FCM_AUTH_FILE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Web Push (VAPID) - generer avec: php -r "require 'vendor/autoload.php'; print_r((new Minishlink\WebPush\VAPID())::createVapidKeys());"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
