# Le code PHP du module n'est jamais execute directement : seuls index.php
# et services.php restent joignables. Les ressources statiques (Resource/js,
# css, images) restent servies normalement.
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "^(index|services)\.php$">
    Require all granted
</FilesMatch>

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]

<IfModule mod_headers.c>
    Header always set X-FRAME-OPTIONS "DENY"
</IfModule>
                
