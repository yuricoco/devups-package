# Le code PHP du module n'est jamais execute directement : seul services.php
# (protege par la session d'administration) reste joignable. Les ressources
# statiques (Resource/js, css, images) restent servies normalement.
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<Files "services.php">
    Require all granted
</Files>

<IfModule mod_headers.c>
    Header always set X-FRAME-OPTIONS "DENY"
</IfModule>
