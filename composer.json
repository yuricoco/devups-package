{
    "name": "spacekola/devups",
    "description": "a php framework",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Aurelien Atemkeng",
            "email": "aurelienatemkeng@spacekola.com",
            "role": "developer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "doctrine/orm": "^3.7",
        "ifsnop/mysqldump-php": "^2.9",
        "phpmailer/phpmailer": "^6.6",
        "mpdf/mpdf": "^8.0",
        "guzzlehttp/guzzle": "^7.5",
        "firebase/php-jwt": "^6.9",
        "barcode-bakery/barcode-1d": "^7.0",
        "zircote/swagger-php": "^4.11",
        "google/apiclient": "^2.18",
        "minishlink/web-push": "^10.0",
        "symfony/cache": "^7.4",
        "illuminate/view": "^11.0",
        "illuminate/events": "^11.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "autoload": {
        "classmap": [
            "dclass/",
            "src/"
        ],
        "psr-0": {
            "": "src/"
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^7.4",
        "symfony/var-exporter": "^7.4",
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.3"
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "kylekatarnls/update-helper": false
        },
        "audit": {
            "ignore": {
                "PKSA-y2cr-5h3j-g3ys": "CVE-2025-45769 (firebase/php-jwt) disputee par les mainteneurs (cle releve de l'appli, pas de la lib) - maj a ^7.0 impossible, google/apiclient->google/auth exige ^6.0. Auth.php fixe HS512 explicitement. Voir TODO.md ETAPE B.5."
            }
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devups\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:e2e": "phpunit --testsuite e2e",
        "phpstan": "phpstan analyse",
        "post-install-cmd": "@php -r \"file_exists('config/constante.php') || copy('config/constante.example.php', 'config/constante.php');\"",
        "post-update-cmd": "@php -r \"file_exists('config/constante.php') || copy('config/constante.example.php', 'config/constante.php');\""
    }
}
